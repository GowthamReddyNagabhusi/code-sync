{
  "family": "codesync-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::767918719257:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::767918719257:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "codesync-postgres",
      "image": "public.ecr.aws/docker/library/postgres:16-alpine",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5432,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "codesync"
        },
        {
          "name": "POSTGRES_USER",
          "value": "codesync"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "${DB_PASSWORD}"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/codesync-backend",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "postgres"
        }
      }
    },
    {
      "name": "codesync-redis",
      "image": "public.ecr.aws/docker/library/redis:7-alpine",
      "essential": false,
      "portMappings": [
        {
          "containerPort": 6379,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/codesync-backend",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "redis"
        }
      }
    },
    {
      "name": "codesync-backend",
      "image": "767918719257.dkr.ecr.ap-south-1.amazonaws.com/codesync:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        },
        {
          "name": "DB_HOST",
          "value": "localhost"
        },
        {
          "name": "DB_PORT",
          "value": "5432"
        },
        {
          "name": "DB_NAME",
          "value": "codesync"
        },
        {
          "name": "DB_USERNAME",
          "value": "codesync"
        },
        {
          "name": "DB_PASSWORD",
          "value": "${DB_PASSWORD}"
        },
        {
          "name": "REDIS_HOST",
          "value": "localhost"
        },
        {
          "name": "REDIS_PORT",
          "value": "6379"
        },
        {
          "name": "ALLOWED_ORIGINS",
          "value": "http://codesync-frontend-767918719257.s3-website.ap-south-1.amazonaws.com"
        },
        {
          "name": "DB_DDL_AUTO",
          "value": "update"
        },
        {
          "name": "SHOW_SQL",
          "value": "false"
        },
        {
          "name": "LOG_LEVEL_APP",
          "value": "INFO"
        },
        {
          "name": "JWT_SECRET",
          "value": "${JWT_SECRET}"
        },
        {
          "name": "JWT_EXPIRATION",
          "value": "86400000"
        },
        {
          "name": "AI_BASE_URL",
          "value": "https://generativelanguage.googleapis.com/v1beta/openai/"
        },
        {
          "name": "AI_MODEL",
          "value": "gemini-3.8-flash"
        },
        {
          "name": "GEMINI_API_KEY",
          "value": "${GEMINI_API_KEY}"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/codesync-backend",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "backend"
        }
      }
    }
  ]
}

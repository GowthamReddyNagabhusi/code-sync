# =============================================================================
# CodeSync Backend Environment Template
# Copy this file to .env or inject these variables into your runtime container.
# =============================================================================

# Server Port
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=codesync
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DDL_AUTO=update
SHOW_SQL=false

# Redis / PubSub Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=your_super_secret_signing_key_at_least_256_bits_long
JWT_EXPIRATION=86400000

# CORS Allowed Origins (comma-delimited)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# OpenAI API Key (Required for Spring AI Code Assistant)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OAuth2 Authentication (Optional for third-party SSO)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Logging Levels
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=WARN
LOG_LEVEL_SQL=WARN

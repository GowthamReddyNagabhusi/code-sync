# =============================================================================
# CodeSync Root Environment Template
# =============================================================================
# Use this template to configure your local development environment or CI/CD secrets.
# Never commit real credentials or secret keys to version control.
# =============================================================================

# --- Backend Configuration ---
SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5433
DB_NAME=codesync
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DDL_AUTO=update

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=replace_with_a_secure_random_256_bit_string
JWT_EXPIRATION=86400000

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
OPENAI_API_KEY=sk-placeholder

# --- Frontend Configuration ---
VITE_API_URL=http://localhost:8080

# --- Cloud / CI/CD Deployment Settings (Optional) ---
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012
AWS_DEPLOY_ROLE_ARN=arn:aws:iam::123456789012:role/GitHubActionsDeployRole
ECR_REPOSITORY=codesync
ECS_CLUSTER=codesync-cluster
ECS_SERVICE=codesync-backend-service
CONTAINER_NAME=codesync-backend
S3_BUCKET_NAME=codesync-frontend-static
